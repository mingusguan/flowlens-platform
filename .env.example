TZ=Asia/Shanghai

IMAGE_REPOSITORY=registry.cn-hangzhou.aliyuncs.com/mingus/flowlens-platform
IMAGE_TAG=replace-with-github-sha
SHARED_NETWORK=mingus-net

FLOWLENS_IMAGE_REPOSITORY=registry.cn-hangzhou.aliyuncs.com/your-namespace/flowlens-admin
FLOWLENS_IMAGE_TAG=latest
SHARED_NETWORK=mingus-net
FLOWLENS_DOCKER_LOG_MAX_SIZE=100m
FLOWLENS_DOCKER_LOG_MAX_FILE=3

FLOWLENS_ADMIN_PORT=8088
LOGGING_FILE_NAME=/app/logs/flowlens-admin.log
FLOWLENS_LOG_HOST_PATH=/data/mingus/flowlens/logs
FLOWLENS_DB_URL=jdbc:mysql://host.docker.internal:13306/flowlens-platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
FLOWLENS_DB_USERNAME=flowlens
FLOWLENS_DB_PASSWORD=flowlens_change_me

FLOWLENS_JWT_ISSUER=flowlens
FLOWLENS_JWT_SECRET=replace-with-a-long-random-production-secret
FLOWLENS_JWT_EXPIRE_MINUTES=480

JAVA_OPTS=-Xms256m -Xmx768m

FLOWLENS_LIVE_CLOUD_ENABLED=true
FLOWLENS_LIVE_COLLECTOR_PROBE_ENABLED=true
FLOWLENS_LIVE_COLLECTOR_EXECUTABLE=python3
FLOWLENS_LIVE_COLLECTOR_SCRIPT=/app/collectors/douyin/saermart_adapter.py
FLOWLENS_DOUYIN_FETCHER_HOST_PATH=/data/mingus/flowlens/DouyinLiveWebFetcher
FLOWLENS_DOUYIN_FETCHER_PATH=/opt/DouyinLiveWebFetcher
FLOWLENS_DOUYIN_USE_LOCAL_DEPS=false
FLOWLENS_BACKEND_URL=http://127.0.0.1:8088
FLOWLENS_LIVE_COLLECTOR_SCHEDULE_DELAY_MS=30000
FLOWLENS_LIVE_COLLECTOR_PROBE_DELAY_MS=60000
FLOWLENS_LIVE_COLLECTOR_PROBE_TIMEOUT_SECONDS=15
FLOWLENS_LIVE_CLIENT_TIMEOUT_SECONDS=45
